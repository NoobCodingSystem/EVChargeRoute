# OPTIONAL: Open Charge Map adds secondary station records. Leave blank for a keyless setup.
OPENCHARGEMAP_API_KEY=

# Frontend origins allowed to call FastAPI (add your Netlify URL on Render).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Generate a long random value for the admin Data Console.
EV_ADMIN_TOKEN=

# Optional service endpoints; defaults are public endpoints.
BEE_API_BASE=https://ev-charging-stations-api.vercel.app
PHOTON_API_BASE=https://photon.komoot.io
OSRM_API_BASE=https://router.project-osrm.org

# Optional absolute SQLite path.
EV_DB_PATH=

# Email OTP (required to enable account email verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM=your-sender@gmail.com

# Vehicle-cloud webhook ingestion (set a long random secret)
VEHICLE_INGEST_TOKEN=replace-with-a-long-random-secret
